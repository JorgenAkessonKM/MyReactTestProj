{
  "name": "myreactviteproject",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n DB,WEB -c yellow,cyan \"npm:dev:db\" \"npm:dev:client\"",
    "dev:client": "vite",
    "dev:db": "node server/db-server.mjs",
    "db:server": "npm run dev:db",
    "start": "npm run build && npm run dev",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "serve": "npm run build && npm run preview"
  },
  "dependencies": {
    "@okta/okta-auth-js": "^7.14.1",
    "@okta/okta-react": "^6.10.0",
    "@reduxjs/toolkit": "^2.11.2",
    "@types/react-redux": "^7.1.34",
    "better-sqlite3": "^12.4.1",
    "bootstrap": "^5.3.8",
    "express": "^5.1.0",
    "react": "^19.2.0",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^19.2.0",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.10.1",
    "redux": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@originjs/vite-plugin-federation": "^1.4.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@types/react-router-dom": "^5.3.3",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4"
  }
}
